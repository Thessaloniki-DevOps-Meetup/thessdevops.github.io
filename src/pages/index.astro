---
import BaseLayout from '../layouts/BaseLayout.astro';
import UpcomingBlock from '../components/UpcomingBlock.astro';
import EventSummary from '../components/EventSummary.astro';
import { formatDateLong, formatNumber, getAllEvents, getPublishedEvents, splitEvents } from '../lib/events';

const events = getAllEvents(); // curated + upcoming from the Meetup feed
const { upcoming, past } = splitEvents(events);

const [nextEvent, ...laterUpcoming] = upcoming;

// Latest past meetups get a summary card; older ones a one-line archive row.
const LATEST = 3;
const latest = past.slice(0, LATEST);
const older = past.slice(LATEST);

// Old links pointed at /#event-<number>; send them to the event's own page.
const legacyAnchors = Object.fromEntries(getPublishedEvents().map((e) => [String(e.frontmatter.number), e.url]));
---

<BaseLayout currentPage="index">
  <script is:inline slot="head" define:vars={{ legacyAnchors }}>
    var m = location.hash.match(/^#event-(\d+)$/);
    if (m && legacyAnchors[m[1]]) location.replace(legacyAnchors[m[1]]);
  </script>

  <UpcomingBlock event={nextEvent} />

  {laterUpcoming.map((e) => <EventSummary event={e} upcoming />)}

  {latest.length > 0 && (
    <section>
      <div class="px-6 pt-10 md:px-10 lg:px-14 text-[11px] tracking-widest text-cream/35"># latest.md</div>
      {latest.map((e) => <EventSummary event={e} />)}
    </section>
  )}

  {older.length > 0 && (
    <section class="px-6 py-10 md:px-10 lg:px-14">
      <div class="text-[11px] tracking-widest text-cream/35 mb-4"># archive.md</div>
      <ul class="divide-y divide-cream/10 border-y border-cream/10">
        {older.map((e) => (
          <li>
            <a href={e.url} class="group flex items-baseline gap-4 py-3 hover:bg-cream/[0.03] transition-colors">
              <span class="text-xs text-cream/40 font-bold tracking-widest shrink-0">{formatNumber(e.frontmatter.number)}</span>
              <span class="min-w-0 flex-1">
                <span class="text-sm lg:text-base font-semibold group-hover:text-accent transition-colors">{e.frontmatter.title}</span>
                {e.frontmatter.description && (
                  <span class="block text-sm text-cream/55 line-clamp-2 md:line-clamp-1">{e.frontmatter.description}</span>
                )}
              </span>
              <span class="text-xs text-cream/50 shrink-0">{formatDateLong(e.frontmatter.date)}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {events.length === 0 && (
    <div class="p-10"><p class="text-cream/50">No events yet.</p></div>
  )}
</BaseLayout>
