---
// "# file.md" label + page title, matching the rest of the site.
interface Props {
  file: string;
  title: string;
  lead?: string;
}
const { file, title, lead } = Astro.props;
---
<header class="px-6 pt-8 md:px-10 lg:px-14 lg:pt-12">
  <a href="/" class="text-xs text-cream/50 hover:text-accent transition-colors">← home</a>
  <div class="text-[11px] tracking-widest text-cream/35 mt-8 mb-3"># {file}</div>
  <h1 class="text-3xl md:text-4xl font-bold leading-tight">{title}</h1>
  {lead && <p class="text-base lg:text-lg text-cream/75 mt-4 leading-relaxed max-w-2xl">{lead}</p>}
  <slot />
</header>
