---
// Top of the home page: the next meetup, or a TBA fallback.
import siteConfig from '../content/site.json';
import { formatDateFull, formatNumber, type EventEntry } from '../lib/events';

interface Props {
  event?: EventEntry;
}
const { event } = Astro.props;
const fm = event?.frontmatter;
---

<section class="px-4 pt-8 pb-2 md:px-8 md:pt-10 lg:px-10 lg:pt-12">
  <!-- Framed like a terminal window so the next meetup stands apart from the list below. -->
  <div class={`rounded-md border overflow-hidden shadow-lg shadow-black/20 ${event ? 'border-accent/60 bg-accent/[0.07]' : 'border-cream/20 bg-cream/[0.03]'}`}>
    <div class={`flex items-center gap-2 px-4 py-2 border-b text-[11px] tracking-widest ${event ? 'border-accent/30 bg-accent/10' : 'border-cream/15 bg-cream/[0.04]'}`}>
      <span class="flex gap-1.5" aria-hidden="true">
        <span class="w-2.5 h-2.5 rounded-full bg-accent"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-cream/30"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-cream/30"></span>
      </span>
      <span class="text-cream/60 ml-2">next.md</span>
    </div>

    <div class="px-5 py-7 md:px-8 md:py-9 lg:px-10">
  {event && fm ? (
    <div>
      <div class="flex items-center gap-3 flex-wrap mb-4">
        <span class="inline-flex items-center px-2 py-0.5 text-[10px] tracking-widest border rounded-sm bg-accent/15 text-accent border-accent/40">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-accent mr-1.5 animate-pulse"></span>
          NEXT UP
        </span>
        {fm.number > 0 && <span class="text-xs text-cream/40 font-bold tracking-widest">{formatNumber(fm.number)}</span>}
      </div>

      <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold leading-tight">
        <a href={event.url} {...(event.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})} class="hover:text-accent transition-colors">{fm.title}</a>
      </h2>

      {fm.description && (
        <p class="text-base lg:text-lg text-cream/80 mt-3 leading-relaxed">{fm.description}</p>
      )}

      <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1.5 mt-6 text-sm lg:text-base">
        <dt class="text-cream/45">when</dt>
        <dd class="text-cream">
          {formatDateFull(fm.date)}
          {fm.time && (
            <>
              <span class="text-cream/30"> · </span>{fm.time}
              <span class="text-cream/50 text-xs lg:text-sm"> (Athens time)</span>
            </>
          )}
        </dd>
        {fm.location && (
          <>
            <dt class="text-cream/45">where</dt>
            <dd class="text-cream">
              {fm.locationUrl ? (
                <a href={fm.locationUrl} target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">{fm.location} ↗</a>
              ) : fm.location}
            </dd>
          </>
        )}
      </dl>

      <div class="flex flex-wrap gap-2 mt-7">
        {fm.meetupUrl && (
          <a href={fm.meetupUrl} target="_blank" rel="noopener noreferrer"
             class="inline-flex items-center gap-1.5 px-3 py-2 text-sm bg-accent text-primary font-semibold rounded-sm hover:bg-cream transition-colors">
            RSVP on Meetup →
          </a>
        )}
        {!event.external && (
          <a href={event.url}
             class="inline-flex items-center gap-1.5 px-3 py-2 text-sm border border-cream/30 text-cream hover:border-accent hover:text-accent transition-colors rounded-sm">
            Details
          </a>
        )}
      </div>
    </div>
  ) : (
    <div>
      <h2 class="text-2xl md:text-3xl font-bold leading-tight">
        Next meetup: <span class="text-cream/50">TBA</span>
      </h2>
      <p class="text-sm lg:text-base text-cream/70 mt-3">
        The next date isn't announced yet. Follow us on Meetup to hear about it first.
      </p>
      {siteConfig.socials.meetup && (
        <a href={siteConfig.socials.meetup} target="_blank" rel="noopener noreferrer"
           class="inline-flex items-center gap-1.5 mt-5 px-3 py-2 text-sm bg-accent text-primary font-semibold rounded-sm hover:bg-cream transition-colors">
          Follow on Meetup →
        </a>
      )}
    </div>
  )}
    </div>
  </div>
</section>
