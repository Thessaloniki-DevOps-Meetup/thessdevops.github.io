---
import siteConfig from '../content/site.json';
---
<div class="flex items-center gap-2 text-xs text-cream/45 mb-3">
  <span class="inline-block w-1.5 h-1.5 rounded-full bg-accent"></span>
  <span class="tracking-widest">DEVOPS · THESSALONÍKI</span>
</div>
<h1 class="text-2xl lg:text-3xl font-bold leading-tight mb-3">
  {siteConfig.name}
</h1>
{siteConfig.tagline && (
  <p class="text-sm lg:text-base text-cream/75 mb-3">{siteConfig.tagline}</p>
)}
{siteConfig.description && (
  <p class="text-sm text-cream/60 leading-relaxed">{siteConfig.description}</p>
)}

<div class="flex flex-wrap gap-1.5 mt-5">
  {siteConfig.socials.meetup && (
    <a href={siteConfig.socials.meetup} target="_blank" rel="noopener noreferrer"
       class="inline-flex items-center gap-1.5 px-2.5 py-1.5 text-sm bg-accent text-primary font-semibold rounded-sm hover:bg-cream transition-colors">
      Join on Meetup →
    </a>
  )}
  {siteConfig.socials.youtube && (
    <a href={siteConfig.socials.youtube} target="_blank" rel="noopener noreferrer"
       class="inline-flex items-center gap-1.5 px-2.5 py-1.5 text-sm border border-cream/30 text-cream hover:border-accent hover:text-accent transition-colors rounded-sm">
      YouTube
    </a>
  )}
  {siteConfig.socials.linkedin && (
    <a href={siteConfig.socials.linkedin} target="_blank" rel="noopener noreferrer"
       class="inline-flex items-center gap-1.5 px-2.5 py-1.5 text-sm border border-cream/30 text-cream hover:border-accent hover:text-accent transition-colors rounded-sm">
      LinkedIn
    </a>
  )}
  {siteConfig.socials.discord && (
    <a href={siteConfig.socials.discord} target="_blank" rel="noopener noreferrer"
       class="inline-flex items-center gap-1.5 px-2.5 py-1.5 text-sm border border-cream/30 text-cream hover:border-accent hover:text-accent transition-colors rounded-sm">
      Discord
    </a>
  )}
  {siteConfig.socials.github && (
    <a href={siteConfig.socials.github} target="_blank" rel="noopener noreferrer"
       class="inline-flex items-center gap-1.5 px-2.5 py-1.5 text-sm border border-cream/30 text-cream hover:border-accent hover:text-accent transition-colors rounded-sm">
      GitHub
    </a>
  )}
</div>

<p class="text-sm text-cream/55 mt-5 max-w-md leading-relaxed">
  Want to <span class="text-cream/80">host</span> or <span class="text-cream/80">sponsor</span>?
  Reach out on any channel above.
</p>

<div class="flex flex-wrap items-center gap-3 mt-4 text-sm text-cream/55">
  <span>Got a talk in mind?</span>
  <a href="/submit-talk"
     class="inline-flex items-center gap-1.5 px-3 py-1.5 border border-accent text-accent hover:bg-accent hover:text-primary transition-colors rounded-sm">
    Submit a talk
  </a>
</div>
