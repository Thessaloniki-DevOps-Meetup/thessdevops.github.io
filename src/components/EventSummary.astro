---
// Compact, clickable event card for the home page list.
import { formatDateLong, formatNumber, getEventPhotos, getEventVideos, type EventEntry, type Talk } from '../lib/events';

interface Props {
  event: EventEntry;
  upcoming?: boolean;
}
const { event, upcoming = false } = Astro.props;
const fm = event.frontmatter;
const talks: Talk[] = fm.talks ?? [];
const photoCount = getEventPhotos(event.slug).length;
const hasVideo = getEventVideos(event).length > 0 ||
  talks.some((t) => t.videoUrl || t.materials?.some((m) => ['video', 'recording'].includes((m.type || '').toLowerCase())));
const ext = event.external ? { target: '_blank', rel: 'noopener noreferrer' } : {};

const meta = [
  talks.length > 0 ? `${talks.length} talk${talks.length === 1 ? '' : 's'}` : null,
  hasVideo ? '▶ video' : null,
  photoCount > 0 ? `${photoCount} photo${photoCount === 1 ? '' : 's'}` : null,
].filter(Boolean);
---

<a href={event.url} {...ext}
   class="group block px-6 py-7 md:px-10 lg:px-14 border-b border-cream/10 hover:bg-cream/[0.03] focus-visible:bg-cream/[0.05] focus-visible:outline-none transition-colors">
  <div class="flex items-baseline justify-between gap-4 flex-wrap">
    <div class="flex items-center gap-3">
      <span class="text-xs text-cream/40 font-bold tracking-widest">{formatNumber(fm.number)}</span>
      {upcoming && (
        <span class="inline-flex items-center px-2 py-0.5 text-[10px] tracking-widest border rounded-sm border-cream/25 text-cream/70">UPCOMING</span>
      )}
    </div>
    <div class="text-xs lg:text-sm text-cream/55">
      {formatDateLong(fm.date)}{fm.location && <span class="text-cream/30"> · </span>}{fm.location}
    </div>
  </div>

  <h3 class="text-xl md:text-2xl font-bold leading-tight mt-2 group-hover:text-accent transition-colors">{fm.title}</h3>

  {fm.description && (
    <p class="text-sm lg:text-base text-cream/75 mt-2 leading-relaxed">{fm.description}</p>
  )}

  {talks.length > 0 && (
    <ul class="mt-3 space-y-1">
      {talks.map((t) => (
        <li class="text-sm text-cream/60 pl-3 border-l border-cream/15">{t.title}</li>
      ))}
    </ul>
  )}

  <div class="flex items-center justify-between gap-4 mt-4 text-xs text-cream/45">
    <span>{meta.join(' · ')}</span>
    <span class="text-accent group-hover:translate-x-0.5 transition-transform">{event.external ? 'meetup ↗' : 'open →'}</span>
  </div>
</a>
