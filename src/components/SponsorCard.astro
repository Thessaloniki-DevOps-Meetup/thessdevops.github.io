---
// Logo tile for a host or sponsor. Logos (src/assets/sponsors/) are shown
// as cream silhouettes so dark and light brand marks all read on the site's
// teal background; the original files are untouched.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Todo from './Todo.astro';

interface Props {
  name: string;
  url: string;
  logo?: ImageMetadata;
  label: string; // e.g. "HOST · 5 MEETUPS"
  note?: string;
  todo?: string;
}
const { name, url, logo, label, note, todo } = Astro.props;
const domain = new URL(url).hostname.replace(/^www\./, '');
---

<li class="border border-cream/15 rounded-md bg-cream/[0.02] hover:border-accent/50 transition-colors">
  <a href={url} target="_blank" rel="noopener noreferrer" class="group block p-5">
    <div class="h-14 flex items-center">
      {logo ? (
        <Image src={logo} alt={`${name} logo`} width={Math.round((logo.width / logo.height) * 56)} height={56}
               class="sponsor-logo max-h-12 w-auto max-w-[220px] object-contain opacity-80 group-hover:opacity-100 transition-opacity" />
      ) : (
        <span class="text-xl font-bold">{name}</span>
      )}
    </div>
    <div class="mt-4 font-bold">{name}</div>
    <div class="text-[11px] tracking-widest text-cream/50 mt-1">{label}</div>
    {note && <p class="text-sm text-cream/65 mt-3 leading-relaxed">{note}</p>}
    <div class="text-xs text-accent mt-3 group-hover:text-cream transition-colors">{domain} ↗</div>
  </a>
  {todo && <p class="px-5 pb-5 -mt-1"><Todo>{todo}</Todo></p>}
</li>

<style>
  /* Any logo colour → cream silhouette. */
  .sponsor-logo { filter: brightness(0) invert(0.96) sepia(0.08); }
</style>
