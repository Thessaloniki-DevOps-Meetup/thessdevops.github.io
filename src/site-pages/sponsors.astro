---
// /sponsors — DRAFT. Why sponsor, ways to help, thank-you section.
// Benefits and tiers are placeholders until agreed (Sponsorship playbook).
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Todo from '../components/Todo.astro';
import SponsorCard from '../components/SponsorCard.astro';
import siteConfig from '../content/site.json';
import sponsors from '../content/sponsors.json';
import type { ImageMetadata } from 'astro';
import { getPage } from '../lib/pages';
import { getPublishedEvents, splitEvents } from '../lib/events';

const page = getPage('sponsors');
const { past } = splitEvents(getPublishedEvents());
const talks = past.flatMap((e) => e.frontmatter.talks ?? []);

// Hosts & sponsors from src/content/sponsors.json; logos from src/assets/sponsors/.
const logos = import.meta.glob<{ default: ImageMetadata }>('../assets/sponsors/*', { eager: true });
const logoFor = (file?: string) => (file ? logos[`../assets/sponsors/${file}`]?.default : undefined);

// How many past meetups each host's venue held (matched on event `location`).
const meetupsAt = (venue?: string) => past.filter((e) => venue && e.frontmatter.location === venue).length;
const plural = (n: number, w: string) => `${n} ${w}${n === 1 ? '' : 'S'}`;

const hosts = sponsors
  .filter((s) => s.kind === 'host')
  .map((s) => ({ ...s, count: meetupsAt(s.venue) }))
  .sort((a, b) => b.count - a.count);
const backers = sponsors.filter((s) => s.kind !== 'host');

const cc = (siteConfig.emailCc ?? []).join(',');
const subject = encodeURIComponent(`Sponsoring the ${siteConfig.name}`);
const mailto = siteConfig.email ? `mailto:${siteConfig.email}?subject=${subject}${cc ? `&cc=${cc}` : ''}` : null;

const section = 'px-6 py-10 md:px-10 lg:px-14 border-t border-cream/10';
const label = 'text-[11px] tracking-widest text-cream/35 mb-4';
const para = 'text-sm lg:text-base text-cream/75 leading-relaxed max-w-2xl';

const ways = [
  { key: 'host', title: 'Host a meetup', text: 'A room, a projector and a mic, on a weekday evening, every month or two.' },
  { key: 'pizza', title: 'Pizza & drinks', text: 'Keep the community fed. The most loved form of sponsorship, by far.' },
  { key: 'swag', title: 'Gifts & swag', text: 'Stickers, t-shirts, books or conference tickets to raffle among attendees.' },
  { key: 'speak', title: 'Send a speaker', text: 'Share real engineering stories from your team (no sales pitches).' },
];
---

<BaseLayout title={page.title} description={page.description} currentPage="sponsors" mobileHero={false}
            draft={page.draft} ogImage="/og/sponsors.png">
  <PageHeader file="sponsors.md" title="Sponsor or host a meetup"
              lead="The meetup is free and run by volunteers. Hosts and sponsors make it possible, and in return you meet the people building and running infrastructure in Thessaloníki." />

  <!-- Why -->
  <section class="px-6 py-8 md:px-10 lg:px-14">
    <div class={label}># why.md</div>
    <ul class="space-y-2 max-w-2xl text-sm lg:text-base text-cream/75">
      <li><span class="text-accent">→</span> Meet DevOps, SRE, platform and cloud engineers in Thessaloníki, in person.</li>
      <li><span class="text-accent">→</span> Show your team's engineering culture to people who care about it (great for hiring).</li>
      <li><span class="text-accent">→</span> Support a free, vendor-neutral community: {past.length} meetups and {talks.length} talks so far.</li>
    </ul>
    <p class="mt-4"><Todo>Add audience numbers (Meetup members, typical attendance) from the Sponsorship playbook.</Todo></p>
  </section>

  <!-- Ways to help -->
  <section class={section}>
    <div class={label}># ways-to-help.yaml</div>
    <ul class="grid sm:grid-cols-2 gap-3 max-w-3xl">
      {ways.map((w) => (
        <li class="border border-cream/15 rounded-md p-5 bg-cream/[0.02]">
          <div class="text-xs tracking-widest text-blue-gray">{w.key}<span class="text-cream/40">:</span></div>
          <div class="font-bold text-lg mt-1">{w.title}</div>
          <p class="text-sm text-cream/70 mt-2 leading-relaxed">{w.text}</p>
        </li>
      ))}
    </ul>
    <div class="mt-6 max-w-2xl border border-dashed border-accent/50 rounded-md p-5">
      <div class="text-xs tracking-widest text-accent mb-2">WHAT SPONSORS GET</div>
      <p class={para}>
        <Todo>Agree benefits and simple tiers from the Sponsorship playbook before publishing. Don't list anything we haven't agreed.</Todo>
      </p>
      <p class="text-sm text-cream/50 mt-3">Ideas to discuss: logo on this page and the event page, a thank-you at the start of the meetup, a short slot to introduce your team, a mention in the Meetup event description.</p>
    </div>
  </section>

  <!-- Thank you -->
  <section class={section} id="thanks">
    <div class={label}># thank-you.md</div>
    <h2 class="text-xl md:text-2xl font-bold mb-2">Thank you to our hosts</h2>
    <p class={para}>These venues opened their doors to us:</p>
    <ul class="grid sm:grid-cols-2 gap-3 max-w-3xl mt-5">
      {hosts.map((h) => (
        <SponsorCard name={h.name} url={h.url} logo={logoFor(h.logo)} note={h.note}
                     label={h.count > 0 ? `HOST · ${plural(h.count, 'MEETUP')}` : 'HOST'} />
      ))}
    </ul>

    <h2 class="text-xl md:text-2xl font-bold mt-10 mb-2">…and our sponsors</h2>
    <p class={para}>Companies that backed our meetups:</p>
    <ul class="grid sm:grid-cols-2 gap-3 max-w-3xl mt-5">
      {backers.map((b) => (
        <SponsorCard name={b.name} url={b.url} logo={logoFor(b.logo)} note={b.note}
                     label={b.contribution ? `SPONSOR · ${b.contribution.toUpperCase()}` : 'SPONSOR'} />
      ))}
    </ul>
  </section>

  <!-- Contact -->
  <section class={section}>
    <div class={label}># contact.md</div>
    <h2 class="text-xl md:text-2xl font-bold">Interested?</h2>
    <p class={`${para} mt-2`}>Drop us a line and tell us how you'd like to help. We'll get back to you.</p>
    {mailto && (
      <a href={mailto} class="inline-flex items-center mt-5 px-3 py-2 text-sm bg-accent text-primary font-semibold rounded-sm hover:bg-cream transition-colors">
        Email the organizers →
      </a>
    )}
  </section>
</BaseLayout>
